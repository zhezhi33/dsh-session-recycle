{
  "name": "dsh-session-recycle",
  "version": "0.2.9",
  "description": "DSH 会话清理插件：在工作区会话上右键或从侧栏底部入口打开清理面板，左栏多选会话、顶部可勾选是否连同文件产物一起删除，删除前二次确认，误删可从回收站恢复。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhezhi33/dsh-session-recycle.git"
  },
  "keywords": ["dsh", "dsh-plugin", "session", "cleanup", "recycle-bin"],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "icon.svg", "screenshots.json", "assets", "README.md", "RELEASE.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  }
}
